# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env.local' for local development:
# =============================================================================

# 1. CANONICAL WEBSITE URL (Required for production SEO, OpenGraph & Sitemaps)
# In local development: http://localhost:3000
# In production: https://your-custom-domain.com (or https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=https://kpranit.com

# 2. CONTACT FORM EMAIL SERVICE (Optional)
# Get a free API key from https://resend.com
# If omitted, contact inquiries will still succeed and log to the server console.
RESEND_API_KEY=
CONTACT_EMAIL=kpranit2105@gmail.com

# 3. AI PORTFOLIO ASSISTANT (Optional)
# Get a free API key from Google AI Studio: https://aistudio.google.com/app/apikey
# If omitted, the assistant will automatically use the built-in deterministic grounding engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
